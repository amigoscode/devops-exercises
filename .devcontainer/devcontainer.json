{
  "name": "Amigoscode DevOps Exercises",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "postCreateCommand": "./academy.sh --list >/dev/null; docker build -q 01-linux-fundamentals >/dev/null || true",
  "postAttachCommand": "echo; echo \"  Amigoscode Academy - run:  ./academy.sh\"; echo",
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  }
}
